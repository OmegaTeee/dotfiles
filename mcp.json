{
  "servers": {
    "prompthub/bridge": {
      "type": "stdio",
      "command": "node",
      "args": ["/Users/visualval/prompthub/mcps/prompthub-bridge.js"],
      "env": {
        "AUTHORIZATION": "Bearer sk-prompthub-vscode-001",
        "PROMPTHUB_URL": "http://127.0.0.1:9090",
        "CLIENT_NAME": "claude-code",
        "API_KEY": "Bearer sk-prompthub-vscode-001",
        "CONTENT_TYPE": "application/json",
        "TOOL_DISCLOSURE": "progressive",
        "TIER1_SERVERS": "sequential-thinking,context7,memory",
        "EXCLUDE_TOOLS": "perplexity-comet,duckduckgo"
      }
    },
    "oraios/serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=agent",
        "activate_project",
        "agent_interface"
      ]
    },
    "headroom": {
      "command": "headroom",
      "args": ["mcp", "serve"]
    },
    "fetch_mcp": {
      "type": "stdio",
      "command": "mcp-server-fetch"
    }
  },
  "inputs": []
}
