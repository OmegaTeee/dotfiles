#autoload
emulate -L zsh

local config_home="${ZSH_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/zsh}"
local -a compiled_files

compiled_files=("$config_home"/**/*.zwc(N.))
(( ${#compiled_files[@]} )) && rm -f -- "${compiled_files[@]}"

print -- "Removed ${#compiled_files[@]} adjacent compiled Zsh module(s)."
print -- "Restarting Zsh to rebuild discovered modules..."
exec zsh
